<!DOCTYPE html>
<html lang="en">
<%- include('partials/head',{title:'Home'}) %>
<body class="bg-gray-50">
<%- include('partials/pubNav', {pages}) %>

<% if(home && home.blocks.length){ %>
  <% home.blocks.forEach(b=>{ %>
    <section class="py-20 max-w-5xl mx-auto px-6">
      <h2 class="text-3xl font-bold mb-4"><%- b.sub %></h2>
      <div class="prose max-w-none"><%- b.body %></div>
    </section>
  <% }) %>
<% }else{ %>
  <!-- fallback hero if no home page created yet -->
  <section class="gradient text-white min-h-screen flex items-center">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h1 class="text-5xl font-extrabold mb-4">Hi, I'm Aftab Mumtaz</h1>
      <p class="text-xl">Full-stack developer & UI enthusiast.</p>
    </div>
  </section>
<% } %>

<!-- PROJECTS (always shown) -->
<section id="projects" class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-center mb-10">Projects</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% projects.forEach(p=>{ %>
        <div class="bg-white rounded-xl shadow hover:shadow-2xl transition overflow-hidden">
          <img src="<%= p.image %>" class="h-48 w-full object-cover">
          <div class="p-5">
            <h3 class="font-semibold text-lg mb-2"><%= p.title %></h3>
            <p class="text-gray-600 text-sm mb-3"><%= p.description %></p>
            <div class="flex flex-wrap gap-2 mb-4"><% p.tech.forEach(t=>{ %><span class="px-2 py-1 bg-indigo-100 text-indigo-700 text-xs rounded"><%= t %></span><% }) %></div>
            <a href="<%= p.link || '#' %>" target="_blank" onclick="fetch('/track',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({projectId:'<%= p._id %>'})})" class="inline-block bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700">Live Demo</a>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>