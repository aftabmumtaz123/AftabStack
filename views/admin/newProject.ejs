<%- include('../partials/header', {title:'New Project'}) %>
<div class="max-w-2xl mx-auto p-6">
  <h1 class="text-2xl font-semibold mb-6">New Project</h1>
  <form action="/api/admin/projects" method="POST" enctype="multipart/form-data" class="bg-white p-6 rounded shadow space-y-4">
    <input name="title" placeholder="Title" required class="w-full px-4 py-2 border rounded">
    <textarea name="description" placeholder="Description" required class="w-full px-4 py-2 border rounded"></textarea>
    <input name="tech" placeholder="Tech stack (comma separated)" required class="w-full px-4 py-2 border rounded">
    <input name="link" placeholder="Live link" class="w-full px-4 py-2 border rounded">
    <input name="image" type="file" required class="w-full">
    <button class="bg-indigo-600 text-white px-4 py-2 rounded">Save</button>
  </form>
</div>
<%- include('../partials/footer') %>