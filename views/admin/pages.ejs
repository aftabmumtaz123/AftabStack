<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head',{title:'Pages'}) %>
<body class="bg-gray-100">
<%- include('../partials/adminNav') %>
<div class="max-w-6xl mx-auto p-6">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-semibold">Pages</h1>
    <a href="/api/admin/pages/new" class="bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700">+ New Page</a>
  </div>
  <div class="grid md:grid-cols-3 gap-6">
    <% pages.forEach(p=>{ %>
      <div class="bg-white rounded-xl shadow p-5">
        <h3 class="font-semibold text-lg mb-1"><%= p.title %></h3>
        <p class="text-sm text-gray-500 mb-3">/<%= p.slug %></p>
        <div class="space-x-2">
          <a href="/api/admin/pages/edit/<%= p._id %>" class="text-indigo-600 hover:underline">Edit</a>
          <form action="/api/admin/pages/<%= p._id %>?_method=DELETE" method="POST" class="inline">
            <button class="text-red-600 hover:underline">Delete</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
</div>
</body>
</html>