<%- include('../partials/header', {title:'Login'}) %>
<div class="min-h-screen flex items-center justify-center">
  <form action="/api/auth/login" method="POST" class="bg-white p-8 rounded shadow w-full max-w-sm">
    <h2 class="text-2xl font-semibold mb-6">Admin Login</h2>
    <input name="email" type="email" placeholder="Email" required class="w-full mb-4 px-4 py-2 border rounded">
    <input name="password" type="password" placeholder="Password" required class="w-full mb-4 px-4 py-2 border rounded">
    <button class="w-full bg-indigo-600 text-white py-2 rounded">Login</button>
  </form>
</div>
<%- include('../partials/footer') %>