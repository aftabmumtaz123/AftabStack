<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head',{title:'Edit Page'}) %>
<body class="bg-gray-100">
<%- include('../partials/adminNav') %>
<div class="max-w-4xl mx-auto p-6">
  <h1 class="text-2xl font-semibold mb-6">Edit Page</h1>
  <form action="/api/admin/pages/<%= page._id %>?_method=PUT" method="POST" class="bg-white rounded-xl shadow p-6 space-y-5">
    <input name="title" value="<%= page.title %>" required class="w-full px-4 py-2 border rounded">
    <input name="slug"  value="<%= page.slug %>" required class="w-full px-4 py-2 border rounded">
    <input name="description" value="<%= page.meta.description %>" class="w-full px-4 py-2 border rounded">
    <input name="keywords" value="<%= page.meta.keywords %>" class="w-full px-4 py-2 border rounded">

    <div id="blocks" class="space-y-3"></div>
    <button type="button" onclick="addBlock()" class="bg-gray-200 px-3 py-1 rounded text-sm">+ Add Section</button>

    <button class="w-full bg-indigo-600 text-white py-2 rounded hover:bg-indigo-700">Update Page</button>
  </form>
</div>
<script>
  const blocks=<%- JSON.stringify(page.blocks) %>;
  let idx=0;
  function addBlock(sub='',body=''){
    const div=document.createElement('div'); div.className='flex space-x-2';
    div.innerHTML=`<input name="sub[]" value="${sub}" placeholder="Section title" class="w-1/3 px-2 py-1 border rounded">
                   <textarea name="body[]" placeholder="Content" class="w-2/3 px-2 py-1 border rounded">${body}</textarea>`;
    document.getElementById('blocks').appendChild(div);
  }
  blocks.forEach(b=>addBlock(b.sub,b.body));
  if(!blocks.length) addBlock();
</script>
</body>
</html>