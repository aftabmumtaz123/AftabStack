<%- include('../partials/header', {title:'Edit Project'}) %>
<div class="max-w-2xl mx-auto p-6">
  <h1 class="text-2xl font-semibold mb-6">Edit Project</h1>
  <form action="/api/admin/projects/<%= project._id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="bg-white p-6 rounded shadow space-y-4">
    <input name="title" value="<%= project.title %>" required class="w-full px-4 py-2 border rounded">
    <textarea name="description" required class="w-full px-4 py-2 border rounded"><%= project.description %></textarea>
    <input name="tech" value="<%= project.tech.join(', ') %>" required class="w-full px-4 py-2 border rounded">
    <input name="link" value="<%= project.link || '' %>" class="w-full px-4 py-2 border rounded">
    <img src="<%= project.image %>" class="h-32 rounded">
    <input name="image" type="file" class="w-full">
    <button class="bg-indigo-600 text-white px-4 py-2 rounded">Update</button>
  </form>
</div>
<%- include('../partials/footer') %>